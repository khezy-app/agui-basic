# Copy to .env to override the Vite dev defaults (see README).
# The defaults assume the dev proxy configured in vite.config.ts.
VITE_API_BASE_URL=/api
VITE_AGUI_URL=/agent
VITE_AGUI_ENABLED=true
# Optional, cosmetic: the model label shown in the AI Cowork status strip. There is no
# default — set it to the backend's OPENAI_MODEL if you want the hint, otherwise it is
# simply not rendered (the frontend cannot discover the model on its own).
# VITE_AGUI_MODEL=deepseek-v4.1-flash
